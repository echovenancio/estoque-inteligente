{
  "expo": {
    "name": "Estoque Inteligente",
    "slug": "estoque-inteligente-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "estoque-inteligente",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para adicionar imagens aos produtos.",
          "cameraPermission": "O app precisa acessar sua câmera para tirar fotos dos produtos."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.echovenancio.estoqueinteligentemobile"
    },
    "android": {
      "package": "com.echovenancio.estoqueinteligentemobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3ed6dbda-8050-4644-8f40-d7954d868590"
      }
    }
  }
}
